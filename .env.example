# Gmail SMTP credentials used by services/mailing.js
USER_MAIL=""
USER_PASS=""

# Feature flag for the contact form captcha. Read by both the form (at build time) and
# api/contact.js (at request time). Set to "false" (or 0/off/no) to turn the captcha off
# without removing the keys below. Unset or any other value means enabled.
PUBLIC_CAPTCHA_ENABLED="true"

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile)
# The site key is public and baked into the Astro build; the secret is only read by api/contact.js.
# Leave both empty to disable the captcha locally. Cloudflare's always-pass test keys:
#   PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
