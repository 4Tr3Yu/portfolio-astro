# Gmail SMTP credentials used by services/mailing.js
USER_MAIL=""
USER_PASS=""

# Captcha feature flag. "false", "0", "off" or "no" disables it; unset means enabled.
PUBLIC_CAPTCHA_ENABLED="true"

# Cloudflare Turnstile keys. Test keys that always pass:
#   PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
