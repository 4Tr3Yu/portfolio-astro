---
import Card from "../Card.astro"
import { currentJobData } from "../../content/experience"
import { currentlyData } from "../../content/currently"
interface Props {
	lang: string
}

const { lang } = Astro.props
---
<section class="mb-24 sm:mb-24 md:mb-48" id="currently">
	<h2 class="text-4xl text-amber-400 font-extrabold mb-8">{ currentJobData[lang].sectionTitle}</h2>
	<div class="grid sm:grid-cols-1 lg:grid-cols-2 gap-4">
		<div class="lg:col-span-1">
			<Card {...currentJobData[lang]}/>
		</div>
		<article class="lg:col-span-1 border border-crimson bg-gradient-to-tl from-crimson/35 to-transparent rounded-md p-4">
			<h3 class="text-2xl text-amber-400 font-semibold mb-4">{currentlyData[lang].title}</h3>
			{currentlyData[lang].paragraphs.map((paragraph: string) => (
				<p class="mb-4"><Fragment set:html={paragraph} /></p>
			))}
		</article>
	</div>
</section>